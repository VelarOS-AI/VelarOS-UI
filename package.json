{
  "name": "velaros-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check:package-pack": "node scripts/release/check-package-pack.mjs",
    "check:package-pack-boundary": "node scripts/release/check-package-pack-boundary.mjs",
    "check:package-pack-safety": "bun run check:package-pack-boundary && node --test scripts/release/safe-package-pack.test.mjs",
    "test:ui": "bun test tests/ui packages/ui/test",
    "check:ui-popover-runtime": "node scripts/ui/check/popoverRuntime.mjs",
    "check:ui-component-library": "node scripts/ui/component-library/generateComponentApi.mjs && node scripts/ui/checks/componentLibraryDocsFreshness.mjs && node scripts/ui/checks/componentLibraryIndependence.mjs",
    "check:ui-package-contracts": "node scripts/ui/checks/packageContracts.mjs",
    "check:ui-form-closure": "node scripts/ui/check/uiComponentFormClosure.mjs",
    "check:ui-color-literal": "node scripts/ui/check/uiColorLiteralClosure.mjs",
    "check:ui-hook-deps": "node scripts/ui/check/reactHookDeps.mjs",
    "build:component-library": "vite build --config component-library/vite.config.ts",
    "dev": "vite --config component-library/vite.config.ts",
    "build": "bun run --cwd packages/ui build",
    "typecheck": "bun run --cwd packages/ui typecheck",
    "lint": "eslint . --quiet",
    "test": "bun run test:ui && bun run --cwd packages/ui test",
    "check:module-ownership": "bun scripts/ownership/check-module-ownership.mjs",
    "check": "bun run build && bun run typecheck && bun run lint && bun run test && bun run check:module-ownership && bun run check:gates && bun run build:component-library",
    "check:gates": "bun run check:ui-component-library && bun run check:ui-package-contracts && bun run check:ui-form-closure && bun run check:ui-color-literal && bun run check:ui-hook-deps && bun run check:package-pack-safety && bun run check:code-style",
    "check:code-style": "arch-guard verify",
    "check:code-style:report": "arch-guard run --no-baseline",
    "check:code-style:fix": "arch-guard run --fix --no-baseline"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^41.10.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.11.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "streamdown": "^2.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "@velaros-ai/arch-guard": "github:VelarOS-AI/VelarOS-Arch-Guard#ce2b221d99c1b93736568f281a180ad3593f086f"
  },
  "dependencies": {
    "@velaros-ai/ui": "workspace:*"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15",
    "dompurify": "3.4.13",
    "fast-uri": "3.1.7",
    "hono": "4.13.7",
    "js-yaml": "4.3.2",
    "mermaid": "11.16.1",
    "qs": "6.16.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VelarOS-AI/VelarOS-UI.git"
  }
}
